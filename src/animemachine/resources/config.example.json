      "2160p": false,
      "1080p": true,
      "1080i": true,
      "720p": true,
      "480p-576p": true
    },
    "subtitles": {
      "CHS": true,
      "CHS+CHT": true,
      "CHT": true,
      "ENG": false
    },
    "subtitleDefaultsByLanguage": {
      "zh-Hans": [
        "CHS",
        "CHS+CHT",
        "CHT"
      ],
      "en": [
        "ENG"
      ],
      "ja": []
    },
    "subtitlePriority": [
      "CHS",
      "CHS+CHT",
      "CHT",
      "ENG",
      "unknown"
    ],
    "resolutionPriority": [
      "2160p",
      "1080p",
      "1080i",
      "720p",
      "480p-576p",
      "unknown"
    ],
    "bitDepthPriority": [
      "10bit",
      "8bit",
      "unknown"
    ],
    "seriesExtrasSingleTorrentOnly": true
  },
  "download": {
    "defaultStartMode": "stopped",
    "requirePlanPreview": true,
    "requireFreeSpaceCheck": true,
    "stopLaterSubmissionsWhenSpaceInsufficient": true,
    "reuseExistingInfohashTask": true
  },
  "differentialPlanning": {
    "stagingDirectoryName": ".anm-staging",
    "samePathSizePolicy": "size_and_skip",
    "replacementRequiresRevisionEvidence": true
  },
  "storageGuard": {
    "minimumFreeTiB": 0.1
  },
  "runtime": {
    "metadataRequestDelaySeconds": 1.2,
    "httpMaximumAttempts": 8,
    "honorRetryAfter": true,
    "exponentialBackoff": true,
    "fullScanOnlyAtMilestonesOrHighRisk": true
  },
  "safety": {
    "neverDeleteExistingMedia": true,
    "requireExactCollectionPartition": true,
    "stageVerifiedRevisions": true,
    "keepOperationHistory": true,
    "crossSeriesCollectionsRequireReview": true
  },
  "applicationUpdate": {
    "automaticCheck": {
      "enabled": false,
      "mode": "notify",
      "time": "04:35"
    }
  }

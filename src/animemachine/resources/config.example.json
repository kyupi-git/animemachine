    "preferCollections": true,
    "oneTaskPerInfohash": true,
    "reuseTaskForAdditionalFiles": true,
    "incrementalAcquisition": {
      "enabled": true,
      "watchAfterCompletion": true,
      "exactFingerprintDimensions": [
        "sourceClass",
        "resourceGroup",
        "subtitle",
        "resolution",
        "videoScan",
        "bitDepth"
      ],
      "preferCompleteCollection": true,
      "keepCompleteWebUntilCompleteBd": true
    },
    "revisionMarkers": [
      "BDBOX",
      "BD-BOX",
      "REV",
      "FIN",
      "RESEED"
    ],
    "strategyOrder": [
      "resourceCompleteness",
      "releaseStrategy",
      "sourceClass",
      "seriesCompleteness",
      "resourceGroup",
      "collectionOrRevision",
      "attachmentCompleteness",
      "resolution",
      "subtitle",
      "bitDepth",
      "torrentCreationDate",
      "size"
    ],
    "contentClassPriority": [
      "bdrip",

{
  "schemaVersion": 2,
  "deployment": {
    "libraryUncRoot": "/Library",
    "qbtLibraryRoot": "/Library",
    "torrentPoolRoot": "/Torrents",
    "historyDirectoryName": ".anm-history"
  },
  "components": {
    "discovery": {
      "kind": "directory",
      "pollMinutes": 30,
      "deepReconcileDays": 14
    },
    "downloadClient": {
      "kind": "qbittorrent",
      "mode": "managed",
      "endpoint": "http://127.0.0.1:8080",
      "credentialRef": "secret://qbittorrent/default",
      "category": "anm",
      "tags": [
        "anm",
        "torrent-meta"
      ]
    },
    "aniRss": {
      "endpoint": "http://127.0.0.1:7789",
      "mode": "prefer",
      "credentialRef": "secret://ani-rss/default",
      "mediaPath": "/Media",
      "syncMinutes": 30,
      "deleteGraceSyncs": 2
    }
  },
  "performance": {
    "initialTorrentBatch": 500,
    "poolScanWorkers": 0,
    "poolCommitEvery": 100,
    "libraryCommitEvery": 100,
    "asyncPlanThreshold": 25,
    "catalogReadDuringSync": true
  },
  "externalLibraries": [
    {
      "id": "external-read-only",
      "kind": "generic",
      "enabled": false,
      "path": "/External",
      "readOnly": true,
      "scanMinutes": 60
    }
  ],
  "playback": {
    "enabled": true,
    "playlistIdleSeconds": 43200,
    "playlistMaximumSeconds": 604800,
    "publicBaseUrl": "",
    "preferDirectPaths": true,
    "directPathMappings": []
  },
  "subtitles": {
    "enabled": true,
    "languages": {
      "zh-Hans": [
        "zh-cn",
        "zh-tw"
      ],
      "en": [
        "en"
      ],
      "ja": [
        "ja"
      ]
    },
    "ffprobe": "ffprobe",
    "archiveTool": "7z",
    "providers": [
      {
        "id": "assrt",
        "name": "ASSRT",
        "enabled": true,
        "apiKeyEnv": "ASSRT_API_TOKEN",
        "endpoints": [
          "https://api.assrt.net",
          "https://api.makedie.me"
        ]
      },
      {
        "id": "opensubtitles",
        "name": "OpenSubtitles",
        "enabled": true,
        "apiKeyEnv": "OPEN_SUBTITLES_API_KEY",
        "endpoints": [
          "https://api.opensubtitles.com/api/v1"
        ]
      }
    ],
    "minimumAutomaticConfidence": 0.92,
    "minimumManualConfidence": 0.78
  },
  "security": {
    "requireAdminAccount": true,
    "trustReverseProxyAuthentication": false,
    "secretsDirectory": "/run/secrets"
  },
  "ui": {
    "language": "zh-Hans",
    "availableLanguages": [
      "zh-Hans",
      "en",
      "ja"
    ],
    "catalogView": "cards",
    "imagesEnabled": true,
    "pageSize": 12,
    "sort": "random",
    "sortDirection": "asc",
    "filterDefaults": {
      "mediaTypes": [
        "tv",
        "movie"
      ],
      "availability": [
        "torrent",
        "ani-rss"
      ],
      "libraryStates": [
        "local",
        "external",
        "submitted",
        "not_in_library"
      ]
    }
  },
  "metadata": {
    "workUniverse": "bangumi-archive-only",
    "archive": {
      "officialManifest": "https://raw.githubusercontent.com/bangumi/Archive/master/aux/latest.json",
      "userMirrors": [],
      "requireOfficialSha256": true,
      "updatePolicy": "weekly"
    },
    "onlineRepair": {
      "enabled": true,
      "deferUntilLocalReady": true,
      "batchSize": 50,
      "providers": [
        "bangumi",
        "mal"
      ],
      "neverAddOutsideArchive": true,
      "reasons": [
        "missing",
        "unknown_date",
        "relation_conflict",
        "stale"
      ]
    },
    "network": {
      "selection": "health_latency",
      "probeTimeoutSeconds": 8,
      "failureCooldownSeconds": 900,
      "archiveManifestEndpoints": [
        "https://raw.githubusercontent.com/bangumi/Archive/master/aux/latest.json",
        "https://cdn.jsdelivr.net/gh/bangumi/Archive@master/aux/latest.json",
        "https://cdn.jsdmirror.com/gh/bangumi/Archive@master/aux/latest.json"
      ],
      "archiveAssetProxyTemplates": [
        "https://gh-proxy.com/{url}",
        "https://ghfast.top/{url}"
      ],
      "bangumiApiEndpoints": [
        "https://api.bgm.tv"
      ],
      "bangumiSubjectCacheEndpoints": [
        "https://bgm-cache.wushuo.top"
      ],
      "malApiEndpoints": [
        "https://api.myanimelist.net/v2"
      ],
      "useSystemProxy": true
    },
    "images": {
      "primaryProvider": "bangumi",
      "fallbackProviders": [
        "mal"
      ],
      "fetchOnDemand": true,
      "fullPrefetch": false,
      "foregroundRequestsPreemptPrefetch": true
    }
  },
  "catalog": {
    "defaultHiddenStates": [
      "nsfw"
    ],
    "incompleteMetadataVisible": true,
    "incompleteMetadataAutoMap": false
  },
  "library": {
    "createPlaceholders": true,
    "preserveExistingMedia": true,
    "reuseEquivalentExistingPath": true,
    "completionRequires": [
      "qbittorrent_complete",
      "target_exists",
      "expected_size"
    ],
    "hashRiskyReplacements": true,
    "completeness": {
      "method": "kind_episode_name_size_v1",
      "thresholds": {
        "complete": 95,
        "nearComplete": 80,
        "high": 60,
        "partial": 30
      }
    }
  },
  "naming": {
    "workTemplate": "『{date}』『{title}』",
    "seriesTemplate": "『{start}－{end}』『「{title}」シリーズ』",
    "yearKnownMonthUnknown": "YYYY_XX",
    "dateUnknown": "20XX_XX",
    "preferExistingEquivalentDirectory": true,
    "renameMalformedExistingDirectory": true,
    "preserveVerifiedCompoundTitles": true,
    "appendSemanticEnglishTitleOnlyWhenVerified": true,
    "seriesTitleMustBeFranchiseRoot": true
  },
  "relations": {
    "strictSeriesRelations": [
      "prequel",
      "sequel",
      "parent",
      "main_story",
      "side_story",
      "spin_off",
      "summary",
      "full_story",
      "alternative_version"
    ],
    "nonGroupingRelations": [
      "same_setting",
      "character_appearance",
      "collaboration",
      "other"
    ],
    "mergeOfficialSplitCours": true,
    "splitCourRequiresExplicitSameSeasonEvidence": true,
    "supplementEpisodeHeuristic": {
      "likelyMergeMaximumEpisodes": 2,
      "reviewFromEpisodes": 3
    },
    "createSeparateMoviesAndIndependentStories": true,
    "mergeNativeUndividedCollectionsWithSharedAttachments": true,
    "deprecatedRecutMarker": "deprecated.txt"
  },
  "scope": {
    "excludeLongRunningContinuous": false
  },
  "torrentPolicy": {
    "acquisitionMethods": {
      "torrent": true,
      "magnet": true
    },
    "contentClasses": {
      "bdrip": true,
      "webrip": true,
      "dvdrip": true,
      "tvrip": false,
      "remux": false,
      "bdmv": false,
      "iso": false
    },
    "regions": {
      "china": true,
      "japan": true,
      "korea": true,
      "usa": true,
      "europe": true,
      "other": true
    },
    "allowUnlisted": {
      "resourceGroup": false,
      "sourceClass": true,
      "resolution": true,
      "subtitle": true
    },
    "sourceFamilies": {
      "archive": [
        "bdrip",
        "dvdrip",
        "remux",
        "bdmv",
        "iso",
        "vhsrip",
        "ldrip"
      ],
      "serial": [
        "webrip",
        "tvrip"
      ]
    },
    "serialSubtitle": {
      "language": "auto"
    },
    "archiveGroupIds": [
      "jsum",
      "vcb-studio",
      "philosophy-raws",

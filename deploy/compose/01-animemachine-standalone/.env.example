# Standalone AnimeMachine. External Ani-RSS is optional; qBittorrent is not configured.
ANM_IMAGE=ghcr.io/kyupi-git/animemachine:0.2.0
ANM_CONFIG_DIR=./config
ANM_DATA_DIR=./data
ANM_IMPORTS_DIR=./imports
ANM_TORRENT_POOL_DIR=./torrents
ANM_LIBRARY_DIR=./library
ANM_EXTERNAL_LIBRARY_DIR=./external/read-only
ANM_ANI_RSS_MEDIA_DIR=./external/ani-rss

# Optional Ani-RSS connection. Leave all three unset for standalone library management.
# ANM_ANI_RSS_URL=http://host.docker.internal:7789
# ANM_ANI_RSS_API_KEY=replace_me
# ANM_ANI_RSS_MODE=prefer
ANM_ADMIN_USERNAME=admin
ANM_ADMIN_PASSWORD=replace_with_a_long_random_password
ANM_AUTH_ENABLED=true
# Host-side Web publication address; the container listener stays on 0.0.0.0:8787.
ANM_BIND_ADDRESS=0.0.0.0
ANM_WEB_PORT=8787
ANM_SYNC_INTERVAL_MINUTES=60
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Optional network settings
# ANM_PUBLIC_URL=http://nas.example:8787
# ANM_CA_BUNDLE=/Config/certs/custom-ca.pem
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,host.docker.internal
# Optional absolute path when Compose is launched with an environment file outside this directory.
# ANM_ENV_FILE=.env

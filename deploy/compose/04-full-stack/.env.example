# Complete stack: AnimeMachine + Torrent Collector + qBittorrent + Ani-RSS.
ANM_IMAGE=ghcr.io/kyupi-git/animemachine:0.2.1
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:5.2.3
ANI_RSS_IMAGE=wushuo894/ani-rss:v3.2.28
TORRENT_COLLECTOR_IMAGE=ghcr.io/kyupi-git/animemachine:0.2.1
ANM_CONFIG_DIR=./config
ANM_DATA_DIR=./data
ANM_IMPORTS_DIR=./imports
ANM_TORRENT_POOL_DIR=./torrents
# Optional host bind path; the default is a Compose-managed volume.
# TORRENT_COLLECTOR_STATE_DIR=./torrent-collector-state
ANM_LIBRARY_DIR=./library
ANM_EXTERNAL_LIBRARY_DIR=./external/read-only
ANM_ANI_RSS_MEDIA_DIR=./external/ani-rss

# Generated by Initialize-AnimeMachine.
ANM_QBT_API_KEY=
ANM_QBT_WEB_USERNAME=admin
ANM_QBT_WEB_PASSWORD=
ANM_ANI_RSS_API_KEY=
ANM_ADMIN_USERNAME=admin
ANM_ADMIN_PASSWORD=
ANM_AUTH_ENABLED=true
ANM_SUBMISSION_ENABLED=true
# Host-side Web publication address; the container listener stays on 0.0.0.0:8787.
ANM_BIND_ADDRESS=0.0.0.0
ANM_WEB_PORT=8787
QBT_BIND_ADDRESS=127.0.0.1
QBT_WEB_PORT=8080
ANI_RSS_BIND_ADDRESS=127.0.0.1
ANI_RSS_WEB_PORT=7789
QBT_LISTEN_PORT=6881
ANM_SYNC_INTERVAL_MINUTES=30
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Torrent Collector advanced tuning is optional; defaults are built in.
# See ../torrent-collector.advanced.env.example only when tuning is necessary.

# ANM_PUBLIC_URL=http://nas.example:8787
# ANM_CA_BUNDLE=/Config/certs/custom-ca.pem
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,qbittorrent,ani-rss
# Optional absolute path when Compose is launched with an environment file outside this directory.

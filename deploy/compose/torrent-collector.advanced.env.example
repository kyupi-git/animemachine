# Optional Torrent Collector tuning. Omit these variables to use validated defaults.
TORRENT_COLLECTOR_FULL_HISTORY_ENABLED=true
TORRENT_COLLECTOR_HISTORY_ENABLED=true
TORRENT_COLLECTOR_FULL_HISTORY_PAGES_PER_CYCLE=10
TORRENT_COLLECTOR_HISTORY_PAGES_PER_JOB_PER_CYCLE=5
TORRENT_COLLECTOR_HISTORY_JOBS_PER_CYCLE=10
TORRENT_COLLECTOR_PAGE_DELAY_SECONDS=1.5
TORRENT_COLLECTOR_HISTORY_RETRY_SECONDS=60
TORRENT_COLLECTOR_REQUEST_TIMEOUT_SECONDS=60
TORRENT_COLLECTOR_HTTP_MAX_RETRIES=5
TORRENT_COLLECTOR_POLL_INTERVAL_SECONDS=3000
TORRENT_COLLECTOR_INCREMENTAL_ENABLED=true
TORRENT_COLLECTOR_INCREMENTAL_PAGES=2
TORRENT_COLLECTOR_RETRY_BATCH_SIZE=100
TORRENT_COLLECTOR_MAX_RETRY_ATTEMPTS=6
TORRENT_COLLECTOR_EXISTING_AUDIT_MODE=report
TORRENT_COLLECTOR_HTML_MAX_BYTES=8388608
TORRENT_COLLECTOR_TORRENT_MAX_BYTES=16777216
TORRENT_COLLECTOR_PROXY_ENABLED=false
TORRENT_COLLECTOR_PROXY_HOST=host.docker.internal
TORRENT_COLLECTOR_PROXY_PORT=1080

# AnimeMachine + Torrent Collector + bundled qBittorrent. External Ani-RSS is optional.
ANM_IMAGE=ghcr.io/kyupi-git/animemachine:0.1.0
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:5.2.3
TORRENT_COLLECTOR_IMAGE=ghcr.io/kyupi-git/animemachine:0.1.0
ANM_CONFIG_DIR=./config
ANM_DATA_DIR=./data
ANM_IMPORTS_DIR=./imports
ANM_TORRENT_POOL_DIR=/host/path/to/torrents
# Optional host bind path; the default is a Compose-managed volume.
# TORRENT_COLLECTOR_STATE_DIR=/host/path/to/torrent-collector-state
ANM_LIBRARY_DIR=/host/path/to/library
ANM_EXTERNAL_LIBRARY_DIR=./external/read-only
ANM_ANI_RSS_MEDIA_DIR=./external/ani-rss

# qBittorrent 5.2.0+; generate these with Initialize-AnimeMachine.
ANM_QBT_API_KEY=
ANM_QBT_WEB_USERNAME=admin
ANM_QBT_WEB_PASSWORD=
# Optional Ani-RSS connection.
# ANM_ANI_RSS_URL=http://host.docker.internal:7789
# ANM_ANI_RSS_API_KEY=replace_me
# ANM_ANI_RSS_MODE=prefer
ANM_ADMIN_USERNAME=admin
ANM_ADMIN_PASSWORD=
ANM_AUTH_ENABLED=true
ANM_BIND_ADDRESS=0.0.0.0
ANM_WEB_PORT=8787
QBT_BIND_ADDRESS=127.0.0.1
QBT_WEB_PORT=8080
QBT_LISTEN_PORT=6881
ANM_SYNC_INTERVAL_MINUTES=60
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Torrent Collector advanced tuning is optional; defaults are built in.
# See ../torrent-collector.advanced.env.example only when tuning is necessary.

# ANM_PUBLIC_URL=http://nas.example:8787
# ANM_CA_BUNDLE=/Config/certs/custom-ca.pem
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,qbittorrent,host.docker.internal
# Optional absolute path when Compose is launched with an environment file outside this directory.
# ANM_ENV_FILE=.env

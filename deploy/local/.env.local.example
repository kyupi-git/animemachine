# AnimeMachine local deployment template. Relative paths are resolved from the
# source repository or extracted Release root. Uncomment only the values to override.

# Web, authentication and submission
# ANM_BIND_ADDRESS=0.0.0.0
# ANM_WEB_PORT=8787
# ANM_PUBLIC_URL=http://192.168.1.10:8787
# Optional locally; required automatically for non-loopback binding.
# ANM_AUTH_ENABLED=true
# ANM_ADMIN_USERNAME=admin
# ANM_ADMIN_PASSWORD=
# ANM_SUBMISSION_ENABLED=true

# Persistent state. Keep these on a local SSD when possible.
# ANM_STATE_DIR=.local/state
# ANM_CONFIG_PATH=config.json
# ANM_CATALOG_DB=.local/state/catalog/anime-catalog.sqlite3
# ANM_RUNTIME_CATALOG_DB=.local/state/catalog/runtime.sqlite3
# ANM_ARCHIVE_DIR=.local/state/metadata/archive
# ANM_METADATA_CACHE_DIR=.local/state/metadata/cache
# ANM_PLAN_DIR=.local/state/plans
# ANM_HISTORY_DIR=.local/state/history
# ANM_IMPORTS_DIR=imports
# ANM_AUTH_DB=.local/state/auth/auth.sqlite3
# ANM_SYNC_STATUS_FILE=.local/state/sync-status.json
# ANM_OFFLINE_METADATA=.local/state/metadata/anime-offline-database.json
# ANM_MANIFEST_CACHE=.local/state/torrent-assets/pool-manifests-current.json

# User storage. Windows accepts drive paths and UNC paths.
# ANM_TORRENT_POOL_DIR=\\server\share\torrents
# ANM_LIBRARY_DIR=\\server\share\anime
# ANM_EXTERNAL_LIBRARY_DIR=\\server\share\external-anime
# ANM_ANI_RSS_MEDIA_DIR=\\server\share\ani-rss-media
# Optional hints: local / network / removable. Normally automatic detection is enough.
# ANM_TORRENT_POOL_STORAGE_TYPE=network
# ANM_LIBRARY_STORAGE_TYPE=network
# ANM_EXTERNAL_LIBRARY_STORAGE_TYPE=network
# ANM_ANI_RSS_MEDIA_STORAGE_TYPE=network
# ANM_INCOMPLETE_STORAGE_TYPE=local

# qBittorrent 5.2.0+; ANM_QBT_LIBRARY_DIR is the path visible to qBittorrent.
# ANM_MANAGED_QBITTORRENT_URL=http://127.0.0.1:8080
# ANM_QBT_API_KEY=
# ANM_QBT_API_KEY_FILE=
# ANM_QBT_LIBRARY_DIR=\\server\share\anime
# ANM_INCOMPLETE_DIR=D:\AnimeMachine\incomplete

# Ani-RSS is optional. prefer / fallback / manual.
# ANM_ANI_RSS_URL=http://127.0.0.1:7789
# ANM_ANI_RSS_API_KEY=
# ANM_ANI_RSS_API_KEY_FILE=
# ANM_ANI_RSS_MODE=prefer

# Subtitle providers
# ASSRT_API_TOKEN=
# OPEN_SUBTITLES_API_KEY=

# Scheduling and large-pool performance
# ANM_SYNC_INTERVAL_MINUTES=30
# ANM_METADATA_REQUEST_INTERVAL=0.6
# ANM_IMAGE_FETCH_WORKERS=16
# ANM_IMAGE_HOST_CONCURRENCY=6
# ANM_IMAGE_INITIAL_CONCURRENCY=12
# ANM_IMAGE_MIN_CONCURRENCY=6
# ANM_IMAGE_FOREGROUND_RESERVE=2
# ANM_IMAGE_PREFETCH_PAGES=8
# ANM_ANI_RSS_PREFETCH_WORKERS=2

# Verified network routing. Semicolon separates multiple endpoints/templates.
# ANM_ARCHIVE_MANIFEST_ENDPOINTS=https://raw.githubusercontent.com/bangumi/Archive/master/aux/latest.json
# ANM_ARCHIVE_ASSET_PROXY_TEMPLATES=https://gh-proxy.com/{url};https://ghfast.top/{url}
# ANM_CA_BUNDLE=D:\AnimeMachine\certs\custom-ca.pem
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
